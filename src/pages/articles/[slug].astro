---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleBody from '@/components/ArticleBody.astro';
import SpencerCredentials from '@/components/SpencerCredentials.astro';
import articles from '@/data/articles.json';
import { SITE } from '@/config/site';
export function getStaticPaths() { return articles.map(article=>({params:{slug:article.slug},props:{article}})); }
const { article } = Astro.props;
const jsonLd = {'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,wordCount:article.wordCount,publisher:{'@type':'Organization',name:SITE.name,url:SITE.url},mainEntityOfPage:`${SITE.url}/articles/${article.slug}/`};
---
<BaseLayout title={`${article.title} | Michelle Turpin P.C.`} description={article.description} jsonLd={jsonLd}>
  <header class="bg-[#101b2c] py-16 lg:py-20 text-white">
    <div class="max-w-[1200px] mx-auto px-4">
      <a href="/articles/" class="text-white/80 hover:underline">← Tax Law Articles</a>
      <h1 class="font-serif font-bold text-4xl lg:text-5xl leading-tight mt-6 max-w-5xl">{article.title}</h1>
      <p class="text-white/75 mt-5">{article.readMinutes} min read · Michelle Turpin P.C.</p>
    </div>
  </header>
  <section class="max-w-[1200px] mx-auto px-4 py-16 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-12">
    <article class="min-w-0">
      <ArticleBody body={article.body} />
      <div class="mt-12 bg-[#FBF9F6] p-6 rounded-lg"><h2 class="font-serif text-2xl font-bold mb-3">Discuss Your Tax Situation</h2><p class="mb-4">Our team represents individuals and businesses in federal and state tax matters.</p><a href="/contact-us/" class="font-bold text-[#C1272D] hover:underline">Schedule a consultation →</a></div>
    </article>
    <SpencerCredentials />
  </section>
</BaseLayout>
