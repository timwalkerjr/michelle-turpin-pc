import RelatedServices from '@/components/tax-penalty/RelatedServices.astro';
import { SITE } from '@/config/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": "IRS Tax Penalty Abatement - Michelle Turpin P.C.",
