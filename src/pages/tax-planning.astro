---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleBody from '@/components/ArticleBody.astro';
import SpencerCredentials from '@/components/SpencerCredentials.astro';
import articles from '@/data/articles.json';
const article = articles.find(a=>a.slug==='tax-planning-for-businesses-strategies-to-maximize-savings-and-compliance')!;
---
<BaseLayout title="Tax Planning for Businesses | Michelle Turpin P.C." description={article.description}>
  <section class="bg-[#101b2c] py-16 lg:py-24 text-white"><div class="max-w-[1200px] mx-auto px-4"><p class="uppercase tracking-wider text-sm mb-4">Business Tax Planning</p><h1 class="font-serif text-4xl lg:text-5xl leading-tight font-bold max-w-4xl">Tax Planning for Businesses: Strategies to Maximize Savings and Compliance</h1><p class="text-xl text-gray-200 mt-6 max-w-3xl">{article.description}</p><a href="/contact-us/" class="inline-block mt-7 bg-[#C1272D] rounded-md px-6 py-3 font-bold">Schedule a Tax Planning Consultation</a></div></section>
  <section class="max-w-[1200px] mx-auto px-4 py-16 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-12"><div class="min-w-0"><ArticleBody body={article.body}/><div class="mt-10 p-6 bg-[#FBF9F6] rounded-lg"><h2 class="font-serif text-2xl font-bold mb-3">Planning for Your Individual Taxes?</h2><p class="mb-3">Our team also advises individuals on federal and state tax matters.</p><a href="/services/individuals-tax-help/" class="text-[#C1272D] font-bold hover:underline">Explore individual tax planning →</a></div></div><SpencerCredentials/></section>
</BaseLayout>
