---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import { SITE } from '@/config/site';

const description = 'Facing a criminal tax investigation or tax evasion charge? Utah criminal tax attorneys at Michelle Turpin, P.C. protect your rights, freedom, and business.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Criminal Tax Law Representation',
  description,
  url: `${SITE.url}/criminal-tax/`,
  areaServed: { '@type': 'State', name: 'Utah' },
  provider: {
    '@type': 'LegalService',
    name: SITE.name,
    url: SITE.url,
    telephone: '+18016850552',
  },
};
---

<BaseLayout
  title="Criminal Tax Lawyers Utah | Michelle Turpin P.C."
  description={description}
  jsonLd={jsonLd}
>
  <section class="relative min-h-[520px] flex items-center overflow-hidden bg-[#0A1728]">
    <img
      src="/assets/images/imagekit/9b4bff48c59524eb63094d56c988364a-1536.jpeg"
      alt="Utah State Capitol at night"
      class="absolute inset-0 h-full w-full object-cover opacity-35"
      width="1536"
      height="857"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#08111f]/95 via-[#08111f]/80 to-[#08111f]/55"></div>
    <div class="relative z-10 mx-auto w-full max-w-[1200px] px-5 py-24 text-white md:px-8 lg:py-32">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-[#F3B8BB]">Federal &amp; State Criminal Tax Defense</p>
      <h1 class="max-w-4xl font-serif text-[44px] font-bold leading-[1.05] text-white md:text-[62px]">Criminal Tax Law</h1>
      <p class="mt-6 max-w-3xl text-xl font-semibold leading-relaxed text-white md:text-2xl">Our experienced criminal tax attorneys will fight for your rights.</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/contact-us/" class="rounded-[6px] bg-[#C1272D] px-6 py-3.5 font-bold text-white no-underline transition hover:bg-[#A91F24]">Get Criminal Tax Help Today</a>
        <a href={SITE.phoneHref} class="rounded-[6px] border border-white/60 px-6 py-3.5 font-bold text-white no-underline transition hover:bg-white/10">Call {SITE.phone}</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto grid max-w-[1200px] gap-12 px-5 md:px-8 lg:grid-cols-[minmax(0,1fr)_380px]">
      <article class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-[#1A1A1A] prose-p:text-[#374151] prose-p:leading-relaxed">
        <h2>Get Criminal Tax Help Today</h2>
        <p><strong>“But I didn’t mean to do anything wrong!”</strong> Most people are stunned to learn that they are under investigation for tax evasion or other tax charges. They may think, “If I just talk to the investigator, surely they will see that I am not a criminal.” That is the wrong move.</p>
        <p>If you suspect that you are the target of a criminal tax investigation, you need experienced legal counsel now. Your freedom, job, business, family, and future may all be at risk. We have decades of criminal tax experience and will be there for you.</p>
        <p>If you are facing criminal tax charges, you want Utah’s criminal tax law professionals on your side. Michelle Turpin P.C. has helped taxpayers across the nation for more than 30 years. Our attorneys provide personal service and experienced representation designed to protect your rights and assets when dealing with the IRS and state taxing authorities.</p>

        <div class="not-prose my-12 rounded-[10px] border-l-4 border-[#C1272D] bg-[#F9F6F0] p-7 md:p-9">
          <p class="mb-2 text-sm font-bold uppercase tracking-[0.14em] text-[#C1272D]">Criminal Tax Case Study</p>
          <h2 class="mb-4 font-serif text-3xl font-bold text-[#1A1A1A]">Stopping government overreach</h2>
          <p class="m-0 text-[17px] leading-relaxed text-[#374151]">A local business owner asserted his rights during a sales tax audit. Upset by that challenge, the auditor referred the matter for criminal investigation. Investigators questioned and intimidated customers and employees. We put up a fight. It took criminal tax experience and a commitment to the client, but prosecutors ultimately declined to file charges.</p>
        </div>

        <h2>Get Criminal Tax Representation You Can Count On</h2>
        <p>Michelle Turpin has represented clients facing criminal tax investigations and prosecutions for more than 30 years. Our team knows the system and has significant experience defending people and businesses targeted by criminal tax investigations.</p>
      </article>

      <aside class="self-start rounded-[10px] bg-[#C1272D] p-6 text-white shadow-xl lg:sticky lg:top-24">
        <p class="mb-2 text-sm font-bold uppercase tracking-[0.14em] text-white/80">Confidential Consultation</p>
        <h2 class="mb-3 font-serif text-3xl font-bold text-white">Talk With a Criminal Tax Attorney</h2>
        <p class="mb-6 leading-relaxed text-white/90">Tell us how to reach you. Do not include Social Security numbers or other highly sensitive information.</p>
        <ContactForm idPrefix="criminal-tax" subject="Criminal tax consultation request" />
      </aside>
    </div>
  </section>

  <section class="bg-[#0A1728] py-16 text-white lg:py-20">
    <div class="mx-auto max-w-[1200px] px-5 md:px-8">
      <div class="grid gap-7 md:grid-cols-2">
        <div class="rounded-[10px] border border-white/15 bg-white/5 p-8">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.14em] text-[#F3B8BB]">Proven Experience</p>
          <h2 class="mb-4 font-serif text-3xl font-bold text-white">More Than 30 Years Defending Taxpayers</h2>
          <p class="m-0 leading-relaxed text-white/80">Michelle Turpin has represented clients in serious federal and state tax matters for decades, including investigations where liberty, livelihood, and business continuity are at stake.</p>
        </div>
        <div class="rounded-[10px] border border-white/15 bg-white/5 p-8">
          <p class="mb-3 text-sm font-bold uppercase tracking-[0.14em] text-[#F3B8BB]">Inside-Out Knowledge</p>
          <h2 class="mb-4 font-serif text-3xl font-bold text-white">Focused Criminal Tax Representation</h2>
          <p class="m-0 leading-relaxed text-white/80">We understand how tax investigations develop and how to respond without making the situation worse. Our attorneys work to protect your rights from first contact through resolution.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#F9F6F0] py-16 lg:py-20">
    <div class="mx-auto grid max-w-[1200px] items-center gap-10 px-5 md:px-8 lg:grid-cols-[380px_minmax(0,1fr)]">
      <img
        src="/assets/images/imagekit/66b10a5de25c2598f7d5d078_60a2dbb60d091276406b000f_michelle-turpin-utah-tax-attorneys-1024.jpeg"
        alt="Michelle Turpin, founder and tax attorney"
        class="h-[420px] w-full rounded-[10px] object-cover object-top shadow-lg"
        width="1024"
        height="768"
        loading="lazy"
      />
      <div>
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.14em] text-[#C1272D]">Comprehensive Tax Counsel</p>
        <h2 class="mb-5 font-serif text-4xl font-bold leading-tight text-[#1A1A1A]">We Also Handle Utah State and Federal Tax Preparation</h2>
        <p class="text-lg leading-relaxed text-[#374151]">Our attorneys understand the broader tax issues that may surround an investigation. They help clients navigate complex federal and state tax rules while dealing with the IRS and other agencies.</p>
        <a href="/tax-planning/" class="mt-4 inline-flex font-bold text-[#C1272D] no-underline hover:underline">Explore tax planning and preparation →</a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 text-center lg:py-20">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="font-serif text-4xl font-bold text-[#1A1A1A]">Do Not Face a Criminal Tax Investigation Alone</h2>
      <p class="mt-4 text-lg leading-relaxed text-[#4B5563]">Speak with a Utah criminal tax attorney before talking with investigators or making decisions that could affect your case.</p>
      <a href={SITE.phoneHref} class="mt-7 inline-flex rounded-[6px] bg-[#C1272D] px-7 py-4 text-lg font-bold text-white no-underline transition hover:bg-[#A91F24]">Call {SITE.phone}</a>
    </div>
  </section>
</BaseLayout>
