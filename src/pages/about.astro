---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutHero from '@/components/about/AboutHero.astro';
import AboutStory from '@/components/about/AboutStory.astro';
import AboutTeam from '@/components/about/AboutTeam.astro';
import AboutTrust from '@/components/about/AboutTrust.astro';
import AboutOffices from '@/components/about/AboutOffices.astro';
import AboutCTA from '@/components/about/AboutCTA.astro';
import { SITE } from '@/config/site';

const description = 'Meet the Utah tax attorneys at Michelle Turpin, P.C., with more than 100 years of combined experience defending taxpayers before the IRS and state agencies.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Michelle Turpin, P.C.',
  description,
  url: `${SITE.url}/about/`,
  mainEntity: {
    '@type': 'LegalService',
    name: SITE.name,
    url: SITE.url,
    telephone: '+18016850552',
    areaServed: { '@type': 'State', name: 'Utah' },
  },
};
---

<BaseLayout
  title="About Our Utah Tax Attorneys | Michelle Turpin, P.C."
  description={description}
  jsonLd={jsonLd}
>
  <AboutHero />
  <AboutStory />
  <AboutTeam />
  <AboutTrust />
  <AboutOffices />
  <AboutCTA />
</BaseLayout>
