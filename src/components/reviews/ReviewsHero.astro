---
// Reviews page hero
---

<section id="reviews-hero" class="relative bg-dark-background py-20 lg:py-28 overflow-hidden">
  <div class="absolute inset-0">
    <img
      src="https://pagesmith-cdn.com/84515c4a/images/eeb27867accb1df13dc69f230096e018-1536.webp"
      alt="Client reviews background"
      class="w-full h-full object-cover opacity-30"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/60 to-black/70"></div>
  </div>

  <div class="relative max-w-[1200px] mx-auto px-4 text-center">
    <p class="text-[#C1272D] text-[14px] lg:text-[16px] uppercase tracking-[0.2em] font-bold mb-4">Testimonials</p>
    <h1 class="text-[44px] lg:text-[60px] font-bold text-white font-serif leading-[1.1] mb-6">
      Client Reviews
    </h1>
    <p class="text-[18px] lg:text-[22px] text-gray-200 italic max-w-[800px] mx-auto leading-relaxed">
      Don't just take our word for it — hear directly from the individuals and businesses we've helped face the IRS.
    </p>

    <!-- Rating summary -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 max-w-[900px] mx-auto">
      <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-[8px] p-6 text-white">
        <p class="text-[#C1272D] text-[36px] font-serif font-bold mb-1">4.9</p>
        <div class="text-yellow-400 text-lg mb-2">★★★★★</div>
        <p class="text-gray-300 text-[14px]">Based on client feedback across Google and our offices</p>
      </div>
      <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-[8px] p-6 text-white">
        <p class="text-white text-[36px] font-serif font-bold mb-1">30+</p>
        <div class="text-gray-400 text-lg mb-2">Years</div>
        <p class="text-gray-300 text-[14px]">Over 30 years helping Utah taxpayers</p>
      </div>
      <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-[8px] p-6 text-white">
        <p class="text-white text-[36px] font-serif font-bold mb-1">1000s</p>
        <div class="text-gray-400 text-lg mb-2">Cases</div>
        <p class="text-gray-300 text-[14px]">Thousands of tax cases successfully resolved</p>
      </div>
    </div>
  </div>
</section>
