---
import reviews from '@/data/reviews.json';
const categories = ['All Reviews', 'Offer in Compromise', 'Audit Defense', 'Tax Planning', 'Tax Appeals'];
---
<section id="reviews-list" class="bg-white py-16 lg:py-20">
  <div class="max-w-[1200px] mx-auto px-4">
    <h2 class="font-serif text-3xl font-bold text-center mb-3">What Our Clients Say</h2>
    <p class="text-[#4B5563] text-center mb-8">Experiences shared by our clients. Select a topic to explore their reviews.</p>
    <div class="flex flex-wrap gap-2 justify-center mb-5" role="group" aria-label="Filter reviews by service">
      {categories.map((category,i)=><button type="button" data-review-filter={category} aria-pressed={i===0?'true':'false'} aria-controls="review-grid" class="review-filter rounded-full border border-gray-300 px-4 py-2 text-sm font-medium">{category}</button>)}
    </div>
    <p id="review-count" role="status" class="text-sm text-center text-[#4B5563] mb-8">{reviews.length} reviews</p>
    <div id="review-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map(review=><figure data-review-category={review.category} class="review-card border border-gray-200 rounded-lg p-6">
        <span class="inline-block bg-[#C1272D]/10 text-[#C1272D] text-xs font-medium px-2 py-1 rounded mb-3">{review.category}</span>
        <div class="text-yellow-600 mb-2" aria-label="5 stars">★★★★★</div>
        <blockquote class="text-[#374151] text-[15px] leading-relaxed italic mb-4">“{review.quote}”</blockquote>
        <figcaption class="pt-3 border-t border-gray-100 font-medium">{review.name}</figcaption>
      </figure>)}
    </div>
    <p id="reviews-empty" hidden class="text-center rounded-lg bg-[#FBF9F6] p-8">We don't currently have a published review specifically about Tax Appeals. <a href="/services/tax-appeals/" class="text-[#C1272D] underline">Explore our tax appeals services</a> or choose another review category.</p>
    <p class="text-sm text-[#6B7280] italic mt-8">Each case is different. Prior results do not guarantee a similar outcome.</p>
  </div>
</section>
<style>
  .review-filter[aria-pressed="true"] { background:#c1272d; color:white; border-color:#c1272d; }
  .review-filter:hover { border-color:#c1272d; }
  .review-filter:focus-visible { outline:3px solid #c1272d; outline-offset:3px; }
  [hidden] { display:none!important; }
</style>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-review-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-review-category]');
  filters.forEach(button=>button.addEventListener('click',()=>{
    const category = button.dataset.reviewFilter;
    let count = 0;
    cards.forEach(card=>{card.hidden=category!=='All Reviews'&&card.dataset.reviewCategory!==category; if(!card.hidden)count++;});
    filters.forEach(filter=>filter.setAttribute('aria-pressed',String(filter===button)));
    document.getElementById('review-count')!.textContent = `${count} ${count===1?'review':'reviews'}${category==='All Reviews'?'':` · ${category}`}`;
    document.getElementById('reviews-empty')!.hidden = count!==0;
  }));
</script>
