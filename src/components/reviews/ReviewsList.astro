---

<section id="reviews-list" class="bg-white py-16 lg:py-20">
  <div class="max-w-[1200px] mx-auto px-4">
    <!-- Featured review -->
    <div class="bg-[rgba(245,239,230,0.6)] rounded-[8px] p-6 lg:p-8 mb-12 border-l-4 border-[#C1272D]">
      <div class="text-yellow-500 text-xl mb-3">★★★★★</div>
      <blockquote class="text-[18px] lg:text-[20px] text-[#1A1A1A] font-serif italic leading-relaxed mb-4">
        {featuredReview.quote}
      </blockquote>
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-full bg-[#C1272D] text-white font-bold flex items-center justify-center shrink-0">{featuredReview.initials}</div>
        <div>
          <p class="text-[#1A1A1A] font-medium">{featuredReview.name}</p>
          <p class="text-[#4B5563] text-[14px]">{featuredReview.service}</p>
        </div>
      </div>
    </div>

    <!-- Section header -->
    <h2 class="text-[30px] lg:text-[36px] font-bold text-[#1A1A1A] font-serif text-center mb-3">
      What Our Clients Say
    </h2>
    <p class="text-[#4B5563] text-[16px] text-center max-w-[700px] mx-auto mb-8">
      Real experiences from real people who trusted us with their tax and bankruptcy matters.
    </p>

    <!-- Filter chips -->
    <div class="flex flex-wrap gap-2 justify-center mb-10">
      {categories.map((cat, i) => (
        <button
          class={`px-4 py-2 rounded-full text-[14px] font-medium border transition ${i === 0 ? 'bg-[#C1272D] text-white border-[#C1272D]' : 'bg-white text-[#1A1A1A] border-gray-300 hover:border-[#C1272D] hover:text-[#C1272D]'}`}
        >{cat}</button>
      ))}
    </div>

    <!-- Reviews grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((review) => (
        <div class="bg-white border border-gray-200 rounded-[8px] p-6 hover:shadow-md hover:border-[#C1272D]/30 transition">
          <span class="inline-block bg-[#C1272D]/10 text-[#C1272D] text-[12px] font-medium uppercase tracking-wider px-2 py-1 rounded mb-3">{review.category}</span>
          <div class="text-yellow-500 text-lg mb-2">★★★★★</div>
          <blockquote class="text-[#374151] text-[15px] leading-relaxed mb-4 italic">
            "{review.quote}"
          </blockquote>
          <div class="flex items-center gap-3 pt-3 border-t border-gray-100">
            <div class="w-10 h-10 rounded-full bg-[#1A1A1A] text-white font-bold flex items-center justify-center text-[12px] shrink-0">{review.initials}</div>
            <p class="text-[#1A1A1A] font-medium text-[14px]">{review.name}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
