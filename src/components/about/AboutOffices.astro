---
// About page: Office locations (simple version)
---

<section id="about-offices" class="bg-[rgba(245,239,230,0.4)] py-16 lg:py-20">
  <div class="max-w-[1200px] mx-auto px-4">
    <h2 class="text-[32px] lg:text-[36px] font-bold text-[#1A1A1A] font-serif text-center mb-12">
      Our Offices
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Salt Lake City -->
      <div class="bg-white rounded-[8px] overflow-hidden shadow-md border border-gray-200">
        <div class="aspect-video bg-gray-100 relative">
          <iframe
            src="https://www.google.com/maps?q=4764+S+900+E,+Salt+Lake+City,+UT+84117&output=embed"
            class="w-full h-full"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Salt Lake City office map"
          ></iframe>
        </div>
        <div class="p-6">
          <h3 class="text-[22px] font-bold text-[#1A1A1A] font-serif mb-2">Salt Lake City</h3>
          <p class="text-[#C1272D] font-medium text-[15px] mb-3">Creekside Office Plaza</p>
          <p class="text-[#374151] text-[15px] leading-relaxed mb-4">
            4764 South 900 East<br/>
            Salt Lake City, UT 84117
          </p>
          <div class="border-t border-gray-200 pt-4">
            <p class="text-[#1A1A1A] font-bold text-[14px] uppercase tracking-wider mb-2">Office Hours</p>
            <p class="text-[#4B5563] text-[14px] mb-1">Monday – Friday: 8:30 AM – 5:00 PM</p>
            <p class="text-[#4B5563] text-[14px] mb-4">Saturday – Sunday: Closed</p>
            <a
              href="tel:+18016850552"
              class="inline-block bg-[#C1272D] text-white rounded-[6px] px-4 py-2 text-[14px] font-medium hover:bg-[#8F1A1F] transition"
            >(801) 685-0552</a>
          </div>
        </div>
      </div>

      <!-- St. George -->
      <div class="bg-white rounded-[8px] overflow-hidden shadow-md border border-gray-200">
        <div class="aspect-video bg-gray-100 relative">
          <iframe
            src="https://www.google.com/maps?q=162+N+400+E,+St+George,+UT+84770&output=embed"
            class="w-full h-full"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="St. George office map"
          ></iframe>
        </div>
        <div class="p-6">
          <h3 class="text-[22px] font-bold text-[#1A1A1A] font-serif mb-2">St. George</h3>
          <p class="text-[#C1272D] font-medium text-[15px] mb-3">162 N. 400 E St., Suite A-204</p>
          <p class="text-[#374151] text-[15px] leading-relaxed mb-4">
            St. George, UT 84770
          </p>
          <div class="border-t border-gray-200 pt-4">
            <p class="text-[#1A1A1A] font-bold text-[14px] uppercase tracking-wider mb-2">Office Hours</p>
            <p class="text-[#4B5563] text-[14px] mb-1">Monday – Friday: 8:30 AM – 5:00 PM</p>
            <p class="text-[#4B5563] text-[14px] mb-4">Saturday – Sunday: Closed</p>
            <a
              href="tel:+18016850552"
              class="inline-block bg-[#C1272D] text-white rounded-[6px] px-4 py-2 text-[14px] font-medium hover:bg-[#8F1A1F] transition"
            >(801) 685-0552</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
