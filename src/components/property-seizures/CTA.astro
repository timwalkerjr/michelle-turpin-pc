---
const { title = 'Need Help With Property Seizures?' } = Astro.props;
---

<section class="bg-white py-12 lg:py-16 border-t border-gray-100">
  <div class="max-w-[1200px] mx-auto px-4">
    <div class="bg-[#1A1A1A] rounded-[8px] p-8 lg:p-10 text-center">
      <h3 class="text-[24px] lg:text-[30px] font-bold text-white font-serif mb-3">
        {title}
      </h3>
      <p class="text-gray-300 text-[16px] mb-6 max-w-[700px] mx-auto">
        Our experienced Utah tax attorneys are ready to help you navigate this issue. Call us today for a consultation.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="tel:+18016850552"
          class="bg-[#C1272D] text-white rounded-[6px] px-6 py-3 text-[15px] font-medium hover:bg-[#8F1A1F] transition flex items-center gap-2"
        >
          <i class="ri-phone-line"></i>
          Call (801) 685-0552
        </a>
        <a
          href="/contact-us"
          class="border border-white/40 text-white rounded-[6px] px-6 py-3 text-[15px] font-normal hover:bg-white/10 transition"
        >
          Send a Message
        </a>
      </div>
    </div>
  </div>
</section>
