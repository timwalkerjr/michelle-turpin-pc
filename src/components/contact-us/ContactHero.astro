---
// Contact page hero
---

<section id="contact-hero" class="relative bg-dark-background py-20 lg:py-24 overflow-hidden">
  <div class="absolute inset-0">
    <img
      src="/assets/media/bdcd84f57896744d6c0b259f68bfbaa2-1536.webp"
      alt="Contact Michelle Turpin P.C."
      class="w-full h-full object-cover opacity-40"
      loading="eager"
    />
    <div class="absolute inset-0 bg-[rgba(26,26,26,0.8)]"></div>
  </div>

  <div class="relative max-w-[1200px] mx-auto px-4 flex flex-col items-center justify-center text-center">
    <h1 class="text-[44px] lg:text-[60px] font-bold text-white font-serif leading-[1.1] mb-6">
      Contact Us
    </h1>
    <p class="text-[18px] lg:text-[22px] text-gray-200 italic max-w-[800px] mx-auto leading-relaxed">
      We fight the IRS to achieve the best possible outcome for you. Don't deal with the IRS alone, contact us for a consultation and find out why our clients recommend us.
    </p>
  </div>
</section>
