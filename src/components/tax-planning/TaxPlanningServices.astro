---

<section id="services" class="bg-white py-16 lg:py-24">
  <div class="max-w-[1200px] mx-auto px-4 flex flex-col gap-14">
    <div class="text-center mb-2">
      <h2 class="text-[32px] lg:text-[38px] font-bold text-[#1A1A1A] font-serif text-center mb-3">
        Tax Questions? We have answers...
      </h2>
      <p class="text-center text-[#4B5563] text-[16px] max-w-[800px] mx-auto">
        Our attorneys are highly experienced and knowledgeable of all <a href="/services/tax-planning" class="text-[#C1272D] underline hover:text-[#8F1A1F]">areas of tax law</a>. They have dealt with nearly every kind of <a href="/services/individuals-tax-help" class="text-[#C1272D] underline hover:text-[#8F1A1F]">tax situation</a> imaginable, and they will be able to help you navigate the complex world of <a href="/services/tax-planning" class="text-[#C1272D] underline hover:text-[#8F1A1F]">tax law</a> as you try to deal with the IRS and other agencies.
      </p>
    </div>

    {categories.map((category) => (
      <div>
        <span class="inline-block bg-[#C1272D] text-white font-serif font-bold text-[20px] px-6 py-2.5 rounded-[6px] mb-6">
          {category.name}
        </span>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {category.items.map((item) => (
            <a href={item.href} class="bg-white border border-gray-200 rounded-[8px] p-4 hover:shadow-md hover:border-[#C1272D]/30 transition flex items-start gap-4 group">
              <div class="w-11 h-11 rounded-full bg-[#C1272D]/10 flex items-center justify-center shrink-0 text-[#C1272D]">
                <i class={item.icon + " text-lg"}></i>
              </div>
              <div>
                <h3 class="text-[16px] font-bold text-[#1A1A1A] font-serif mb-1 group-hover:text-[#C1272D] transition">{item.title}</h3>
                <p class="text-[#4B5563] text-[13px] leading-relaxed">{item.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>