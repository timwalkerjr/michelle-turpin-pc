  { name: "Individual Taxes", items: individualTaxes, icon: "ri-user-line" },
  { name: "Business Taxes", items: businessTaxes, icon: "ri-file-list-3-line" },
  { name: "Settlement Options", items: settlementOptions, icon: "ri-scales-line" },
