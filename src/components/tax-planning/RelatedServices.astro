---
const services = [
  {
    title: 'Tax Planning for Individuals',
    desc: 'Strategic tax planning to reduce your personal tax burden and avoid future issues.',
    href: '/services/tax-planning-for-individuals',
    icon: 'ri-user-line'
  },
  {
    title: 'Strategic Business Tax Planning',
    desc: 'The IRS code is complex. We help Utah Business Owners plan to save on taxes.',
    href: '/services/tax-planning-for-businesses',
    icon: 'ri-file-list-3-line'
  },
  {
    title: 'Individuals Tax Help',
    desc: 'We can help assist you with all of your personal taxes, both State and Federal. Call for a consultation today.',
    href: '/services/individuals-tax-help',
    icon: 'ri-scales-line'
  }
];
---

<section class="bg-white py-16 lg:py-20 border-t border-gray-200">
  <div class="max-w-[1200px] mx-auto px-4">
    <h2 class="text-[28px] lg:text-[36px] font-bold text-[#1A1A1A] font-serif text-center mb-12">
      Explore Related Services
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((s) => (
        <a
          href={s.href}
          class="bg-white border border-gray-200 rounded-[8px] p-6 hover:shadow-md hover:border-[#C1272D]/30 transition flex flex-col items-start gap-4"
        >
          <div class="w-12 h-12 rounded-full bg-[#C1272D]/10 flex items-center justify-center text-[#C1272D] shrink-0">
            <i class={`${s.icon} text-2xl`}></i>
          </div>
          <div>
            <h3 class="text-[18px] font-bold text-[#1A1A1A] font-serif mb-2 leading-snug">
              {s.title}
            </h3>
            <p class="text-[#374151] text-[14px] leading-relaxed">
              {s.desc}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
