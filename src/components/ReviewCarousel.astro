---
import reviews from '@/data/reviews.json';
interface Props { id: string; label: string; compact?: boolean }
const { id, label, compact = false } = Astro.props;
const firstNames = ['Adrienne Prude', 'Joanna Smith', 'Johnnie Sasaki'];
const orderedReviews = [...reviews].sort((a,b) => {
  const rank = (name:string) => firstNames.includes(name) ? firstNames.indexOf(name) : firstNames.length;
  return rank(a.name) - rank(b.name);
});
const excerpt = (quote:string) => quote.length > 240 ? quote.slice(0, quote.lastIndexOf(' ', 240)) + '…' : quote;
---
<section class="review-carousel w-full min-w-0 text-left" aria-label={label} aria-roledescription="carousel" data-carousel>
  <div id={id} class:list={['review-track', { compact }]} tabindex="0" aria-label="Reviews; scroll to read more">
    {orderedReviews.map((review) => (
      <figure class="review-card rounded-lg bg-black/35 border border-white/25 p-6 text-white">
        <div class="text-[#fbbf24] tracking-wider mb-3" aria-label="5 stars">★★★★★</div>
        <blockquote class="text-[15px] leading-relaxed italic">“{excerpt(review.quote)}”</blockquote>
        <figcaption class="mt-4 text-sm font-medium">— {review.name}</figcaption>
      </figure>
    ))}
  </div>
  <div class="flex items-center justify-between gap-3 mt-4 text-white">
    <button type="button" data-prev aria-label="Previous reviews" aria-controls={id} class="border border-white/60 rounded-md px-4 py-2 hover:bg-white/15 disabled:opacity-40">← Previous</button>
    <span class="text-sm" data-position aria-live="polite"></span>
    <button type="button" data-next aria-label="Next reviews" aria-controls={id} class="border border-white/60 rounded-md px-4 py-2 hover:bg-white/15 disabled:opacity-40">Next →</button>
  </div>
  <a href="/reviews/" class="inline-block text-sm text-white underline mt-4">Read full client reviews</a>
</section>
<style>
  .review-track { display:flex; gap:1.5rem; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:thin; padding-bottom:.5rem; }
  .review-card { flex:0 0 100%; scroll-snap-align:start; margin:0; }
  @media(min-width:768px) { .review-track:not(.compact) .review-card { flex-basis:calc((100% - 3rem)/3); } }
  button:focus-visible, .review-track:focus-visible { outline:3px solid #fbbf24; outline-offset:4px; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(root => {
    const track = root.querySelector<HTMLElement>('.review-track')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const position = root.querySelector<HTMLElement>('[data-position]')!;
    const update = () => {
      const step = track.children[0].getBoundingClientRect().width + 24;
      const first = Math.round(track.scrollLeft / step) + 1;
      const count = Math.max(1, Math.round((track.clientWidth + 24) / step));
      prev.disabled = track.scrollLeft < 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      position.textContent = `${first}–${Math.min(first + count - 1, track.children.length)} of ${track.children.length}`;
    };
    const move = (direction:number) => track.scrollBy({left:direction*(track.clientWidth+24), behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
    prev.addEventListener('click',()=>move(-1));
    next.addEventListener('click',()=>move(1));
    track.addEventListener('scroll',update,{passive:true});
    new ResizeObserver(update).observe(track);
    update();
  });
</script>
