---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceSidebar from '@/components/services/ServiceSidebar.astro';
import { SITE } from '@/config/site';
interface Props { title:string; description:string; path:string }
const { title, description, path } = Astro.props;
---
<BaseLayout title={`${title} | Michelle Turpin P.C.`} description={description} jsonLd={{'@context':'https://schema.org','@type':'LegalService',name:title,description,url:`${SITE.url}${path}`,provider:{'@type':'Organization',name:SITE.name}}}>
  <section class="bg-[#101b2c] py-16 lg:py-24 text-white">
    <div class="max-w-[1200px] mx-auto px-4">
      <nav aria-label="Breadcrumb" class="text-sm mb-6"><a href="/" class="hover:underline">Home</a> / <span>Tax Appeals</span></nav>
      <h1 class="font-serif text-4xl lg:text-5xl font-bold mb-5">{title}</h1>
      <p class="text-xl text-gray-200 max-w-3xl leading-relaxed">{description}</p>
    </div>
  </section>
  <section class="max-w-[1200px] mx-auto px-4 py-16 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-12">
    <article class="prose prose-lg max-w-none prose-headings:font-serif prose-a:text-[#C1272D] min-w-0">
      <slot />
      <div class="not-prose bg-[#1A1A1A] text-white p-7 rounded-lg mt-10"><h2 class="font-serif text-2xl font-bold mb-3 text-white">Have Your Notice Reviewed Promptly</h2><p class="text-gray-200 mb-5">Bring the IRS notice and supporting records so our team can assess the next step and applicable deadline.</p><a href="/contact-us/" class="inline-block bg-[#C1272D] text-white px-5 py-3 rounded-md font-bold">Schedule a Consultation</a></div>
      <p class="text-sm text-gray-500 mt-8">General information only. Your notice and circumstances determine the procedures and deadlines that apply.</p>
    </article>
    <ServiceSidebar currentPath={path} topicTitle={title} />
  </section>
</BaseLayout>
