---
import articles from '@/data/articles.json';
---
<section id="articles-list" class="bg-white py-16 lg:py-20">
  <div class="max-w-[1200px] mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-8">
    {articles.map(article=><article class="border border-gray-200 rounded-lg p-7 hover:shadow-md transition flex flex-col">
      <p class="text-sm text-[#6B7280] mb-3">Tax Law Articles · {article.readMinutes} min read</p>
      <h2 class="font-serif text-2xl font-bold mb-4"><a href={`/articles/${article.slug}/`} class="hover:text-[#C1272D]">{article.title}</a></h2>
      <p class="text-[#374151] leading-relaxed mb-6 flex-1">{article.description}</p>
      <a href={`/articles/${article.slug}/`} class="font-bold text-[#C1272D] hover:underline" aria-label={`Read ${article.title}`}>Read article →</a>
    </article>)}
  </div>
</section>
