---
const services = [
  {
    title: 'Business Bank Levy',
    description: 'If your Utah business is facing an IRS Bank Levy we may be able to help you. Contact our Business Levy Legal Team Today.',
    href: '/services/business-bank-levy',
    icon: 'ri-bank-line'
  },
  {
    title: 'Federal and State Tax Liens',
    description: 'When you owe taxes, a tax lien may be filed against your Utah property. Call our Utah Tax Lien Attorneys today.',
    href: '/services/tax-liens',
    icon: 'ri-file-list-3-line'
  },
  {
    title: 'State Tax Problem',
    description: 'Unpaid Employment Taxes, State Taxing Authority Problems? Our Utah Tax Lawyers can help.',
    href: '/services/state-tax-problem',
    icon: 'ri-government-line'
  }
];
---

<section class="py-16 lg:py-20" style="background-color: rgba(245, 239, 230, 0.4);">
  <div class="max-w-[1200px] mx-auto px-4">
    <h2 class="text-[28px] lg:text-[36px] font-bold text-[#1A1A1A] font-serif text-center mb-10">
      Explore Related Services
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((s) => (
        <a href={s.href} class="group bg-white border border-gray-200 rounded-[8px] p-6 hover:shadow-lg hover:border-[#C1272D]/40 transition flex items-start gap-4">
          <span class="w-12 h-12 rounded-full bg-[#C1272D]/10 flex items-center justify-center shrink-0 text-[#C1272D]">
            <i class={s.icon + ' text-xl'}></i>
          </span>
          <div>
            <h3 class="text-[17px] font-bold text-[#1A1A1A] font-serif mb-2 group-hover:text-[#C1272D] transition">
              {s.title}
            </h3>
            <p class="text-[14px] text-[#374151] leading-relaxed">
              {s.description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
