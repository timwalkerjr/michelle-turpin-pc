---
const services = [
  {
    title: 'Business Tax Penalty',
    desc: 'Our tax penalty attorneys can represent you to the IRS and work to abate your penalties.',
    href: '/services/business-tax-penalty',
    icon: 'ri-file-list-3-line'
  },
  {
    title: 'Trust Fund Recovery Penalty (TFRP)',
    desc: 'Facing an IRS Trust Fund Recovery Penalty? Michelle Turpin P.C. defends individuals against personal liability.',
    href: '/services/trust-fund-recovery-penalty',
    icon: 'ri-scales-line'
  },
  {
    title: 'Tax Appeals',
    desc: 'You may have the right to a Tax Appeal with the IRS. Our IRS Tax Appeals Attorneys can help you.',
    href: '/services/tax-appeals',
    icon: 'ri-auction-line'
  }
];
---

<section class="bg-white py-16 lg:py-20 border-t border-gray-200">
  <div class="max-w-[1200px] mx-auto px-4">
    <h2 class="text-[28px] lg:text-[36px] font-bold text-[#1A1A1A] font-serif text-center mb-12">
      Explore Related Services
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((s) => (
        <a
          href={s.href}
          class="bg-white border border-gray-200 rounded-[8px] p-6 hover:shadow-md hover:border-[#C1272D]/30 transition flex flex-col items-start gap-4"
        >
          <div class="w-12 h-12 rounded-full bg-[#C1272D]/10 flex items-center justify-center text-[#C1272D] shrink-0">
            <i class={`${s.icon} text-2xl`}></i>
          </div>
          <div>
            <h3 class="text-[18px] font-bold text-[#1A1A1A] font-serif mb-2 leading-snug">
              {s.title}
            </h3>
            <p class="text-[#374151] text-[14px] leading-relaxed">
              {s.desc}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
