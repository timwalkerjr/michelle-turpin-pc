  <div class="relative max-w-[1400px] mx-auto px-4 md:px-8" data-ps="src/components/services/innocent-spouse-relief/ServiceHero.astro:container">
    <nav class="text-gray-300 text-[14px] mb-6" aria-label="Breadcrumb" data-ps="src/components/services/innocent-spouse-relief/ServiceHero.astro:breadcrumbs">
      <a href="/" class="hover:text-white transition" data-ps="src/components/services/innocent-spouse-relief/ServiceHero.astro:kf5mr1">Home</a>
      <span class="mx-2 text-gray-500" data-ps="src/components/services/innocent-spouse-relief/ServiceHero.astro:3sojhf">/</span>
      <a href="/services/audit-help" class="hover:text-white transition" data-ps="src/components/services/innocent-spouse-relief/ServiceHero.astro:kf5mr0">Tax Services</a>
      <span class="mx-2 text-gray-500" data-ps="src/components/services/innocent-spouse-relief/ServiceHero.astro:3sojhe">/</span>
      <span class="text-white font-medium" data-ps="src/components/services/innocent-spouse-relief/ServiceHero.astro:3sojhd">Innocent Spouse Relief</span>
