---
// Service page hero for Audit Help
---

<section id="hero" class="relative bg-dark-background py-20 lg:py-28 overflow-hidden">
  <div class="absolute inset-0">
    <img src="https://images.pexels.com/photos/7821576/pexels-photo-7821576.jpeg?auto=compress&cs=tinysrgb&w=1200"
      srcset="https://images.pexels.com/photos/7821576/pexels-photo-7821576.jpeg?auto=compress&cs=tinysrgb&w=320 320w, https://images.pexels.com/photos/7821576/pexels-photo-7821576.jpeg?auto=compress&cs=tinysrgb&w=640 640w, https://images.pexels.com/photos/7821576/pexels-photo-7821576.jpeg?auto=compress&cs=tinysrgb&w=1024 1024w, https://images.pexels.com/photos/7821576/pexels-photo-7821576.jpeg?auto=compress&cs=tinysrgb&w=1920 1920w"
      sizes="100vw"
      alt="IRS Audit Review Defense"
      class="w-full h-full object-cover opacity-35"
      loading="eager"
      fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/85 via-black/70 to-black/85"></div>
  </div>

  <div class="relative max-w-[1400px] mx-auto px-4 md:px-8 text-center">
    <div class="inline-block bg-[#C1272D] text-white font-medium text-[12px] uppercase tracking-wider px-3 py-1 rounded-[6px] mb-4">
      IRS & State Audit Defense
    </div>
    <h1 class="text-[38px] lg:text-[54px] font-bold text-white font-serif mb-4 leading-[1.1] max-w-[1000px] mx-auto">
      IRS and State Tax Audit Help: Expert Defense for Individuals & Businesses
    </h1>
    <p class="text-[18px] lg:text-[22px] text-gray-200 italic max-w-[850px] mx-auto leading-relaxed">
      Expert audit legal representation for IRS, State, and Local Tax Issues. Find out how audits work.
    </p>
  </div>
</section>
