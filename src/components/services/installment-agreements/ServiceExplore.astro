---
const related = [
  { title: "Offer in Compromise", excerpt: "The IRS Offer in Compromise is an excellent way to settle taxes with the IRS for less than owed.", href: "/services/offer-in-compromise-with-utah-tax-attorney" },
  { title: "Collection Appeals", excerpt: "Has the IRS rejected your Installment Agreement? We can appeal your case before the IRS.", href: "/services/collection-appeals" },
  { title: "Settle Tax Debt Today", excerpt: "Take action now to settle your tax debt with the IRS. Learn your options today.", href: "/services/settle-tax-debt-today" },
];
---

<section id="service-explore" class="bg-white py-16 lg:py-20">
  <div class="max-w-[1400px] mx-auto px-4">
    <h2 class="text-[28px] lg:text-[36px] font-bold text-[#1A1A1A] font-serif text-center mb-10">Explore Related Services</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {related.map((s, __psIdx) => (
        <a href={s.href} class="bg-white border border-gray-200 rounded-[8px] p-6 hover:shadow-md hover:border-[#C1272D]/30 transition flex flex-col">
          <h3 class="text-[18px] font-bold text-[#1A1A1A] font-serif mb-2 leading-tight">{s.title}</h3>
          <p class="text-[#4B5563] text-[14px] leading-relaxed mb-3 flex-1">{s.excerpt}</p>
          <span class="text-[#C1272D] font-medium text-[14px]">Learn More →</span>
        </a>
      ))}
    </div>
  </div>
</section>
