---
// Chapter 7 Bankruptcy Hero with topic background and subtle dark overlay
---

<section id="hero" class="relative bg-dark-background py-20 lg:py-28 overflow-hidden" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:root">
  <div class="absolute inset-0" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:bg-wrap">
    <img
      src="https://images.pexels.com/photos/6077091/pexels-photo-6077091.jpeg?auto=compress&cs=tinysrgb&w=1200"
      srcset="https://images.pexels.com/photos/6077091/pexels-photo-6077091.jpeg?auto=compress&cs=tinysrgb&w=320 320w, https://images.pexels.com/photos/6077091/pexels-photo-6077091.jpeg?auto=compress&cs=tinysrgb&w=640 640w, https://images.pexels.com/photos/6077091/pexels-photo-6077091.jpeg?auto=compress&cs=tinysrgb&w=1024 1024w, https://images.pexels.com/photos/6077091/pexels-photo-6077091.jpeg?auto=compress&cs=tinysrgb&w=1920 1920w"
      sizes="100vw"
      alt="Chapter 7 Bankruptcy - Debt Liquidation and Legal Relief"
      class="w-full h-full object-cover opacity-35"
      loading="eager"
      fetchpriority="high"
      data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:img"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/85 via-black/70 to-black/85" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:overlay"></div>
  </div>

  <div class="relative max-w-[1400px] mx-auto px-4 md:px-8" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:container">
    <nav class="text-gray-300 text-[14px] mb-6" aria-label="Breadcrumb" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:breadcrumbs">
      <a href="/" class="hover:text-white transition" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:6iu9se">Home</a>
      <span class="mx-2 text-gray-500" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:jr4m1k">/</span>
      <a href="/services/audit-help" class="hover:text-white transition" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:6iu9sf">Tax Services</a>
      <span class="mx-2 text-gray-500" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:jr4m1l">/</span>
      <span class="text-white font-medium" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:jr4m1m">Chapter 7 Bankruptcy</span>
    </nav>

    <span class="inline-block bg-[#C1272D] text-white font-medium text-[12px] uppercase tracking-wider px-3 py-1 rounded-[6px] mb-4" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:badge">
      Bankruptcy Relief
    </span>
    <h1 class="text-[40px] lg:text-[56px] font-bold text-white font-serif leading-[1.1] mb-4 max-w-[950px]" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:heading">
      Chapter 7 Bankruptcy
    </h1>
    <p class="text-[18px] lg:text-[22px] text-gray-200 italic max-w-[850px] leading-relaxed" data-ps="src/components/services/chapter-7-bankruptcy/ServiceHero.astro:subhead">
      Chapter 7 Bankruptcy Attorneys. Salt Lake City and all of Utah. Call today for a clean financial start.
    </p>
  </div>
</section>
