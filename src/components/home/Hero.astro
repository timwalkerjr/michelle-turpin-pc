---
import ReviewCarousel from '@/components/ReviewCarousel.astro';
---

<section id="hero" class="relative isolate bg-[#1A1A1A] py-20 lg:py-28 overflow-hidden">
  <!-- Background Image with Dark Gradient Scrim -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <img
      src="/assets/images/salt-lake-city-mountains.jpg"
      alt="Salt Lake City skyline beneath the Wasatch Mountains" width="2048" height="951"
      class="w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/25 via-black/20 to-black/55"></div>
  </div>

  <div class="max-w-[1200px] mx-auto px-4 flex flex-col items-center justify-center text-center">
    <h1 class="text-[40px] font-bold text-white font-serif leading-[1.1] mb-5">
      Utah Tax Attorneys
    </h1>
    <p class="text-[18px] sm:text-[20px] lg:text-[22px] text-gray-200 italic max-w-[860px] mx-auto leading-relaxed mb-12 sm:mb-16">
      We fight the IRS to achieve the best possible outcome for you. Don't deal with the IRS alone — contact us for a consultation and find out why our clients recommend us.
    </p>

    <ReviewCarousel id="hero-reviews" label="Client reviews" />
  </div>
</section>
