---
const serviceGroups = [
  {
    title: 'Individual Tax Problems',
    description: 'Representation for audits, tax liens, levies, wage garnishments, unfiled returns, and innocent spouse matters.',
    href: '/services/individuals-tax-help/',
    linkLabel: 'Explore individual tax services',
    issues: ['IRS and state audits', 'Liens, levies, and garnishments', 'Unfiled returns and penalties'],
  },
  {
    title: 'Business Tax Problems',
    description: 'Experienced counsel for business audits, payroll and sales tax disputes, bank levies, penalties, and appeals.',
    href: '/services/irs-representation-for-business/',
    linkLabel: 'Explore business tax services',
    issues: ['Business audit defense', 'Payroll and trust fund taxes', 'State and federal tax appeals'],
  },
  {
    title: 'Tax Resolution & Bankruptcy',
    description: 'Practical options for resolving tax debt, including installment agreements, offers in compromise, appeals, and bankruptcy.',
    href: '/services/offer-in-compromise-with-utah-tax-attorney/',
    linkLabel: 'Explore resolution options',
    issues: ['Offers in compromise', 'Installment agreements', 'Tax debt in bankruptcy'],
  },
];
---

<section id="services" class="relative isolate bg-white py-16 lg:py-24">
  <div class="max-w-[1200px] mx-auto px-4">
    <div class="text-center max-w-[780px] mx-auto mb-12">
      <p class="text-[#C1272D] font-bold uppercase tracking-wider text-sm mb-3">How we help</p>
      <h2 class="text-[32px] sm:text-[36px] lg:text-[40px] font-bold text-[#1A1A1A] font-serif mb-4 leading-tight">
        Clear paths through complex tax problems
      </h2>
      <p class="text-[#4B5563] text-[16px] leading-[1.65]">
        Whether the issue affects you, your family, or your business, our attorneys can assess the problem and help identify the strongest path forward.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {serviceGroups.map((group) => (
        <article class="border border-gray-200 rounded-[10px] p-6 lg:p-7 bg-white shadow-sm hover:shadow-md hover:border-[#C1272D]/40 transition flex flex-col">
          <div class="w-12 h-1 bg-[#C1272D] rounded-full mb-6"></div>
          <h3 class="text-[23px] font-bold text-[#1A1A1A] font-serif mb-3">{group.title}</h3>
          <p class="text-[#4B5563] text-[15px] leading-relaxed mb-5">{group.description}</p>
          <ul class="space-y-2 text-[14px] text-[#374151] mb-7" aria-label={`Common ${group.title.toLowerCase()} matters`}>
            {group.issues.map((issue) => (
              <li class="flex gap-2"><span class="text-[#C1272D] font-bold" aria-hidden="true">✓</span>{issue}</li>
            ))}
          </ul>
          <a href={group.href} class="mt-auto text-[#C1272D] font-bold hover:text-[#8F1A1F] transition">
            {group.linkLabel} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <div class="text-center mt-10">
      <a href="/contact-us/" class="inline-flex items-center justify-center bg-[#C1272D] text-white px-7 py-3 rounded-[6px] font-bold hover:bg-[#941E22] transition">
        Discuss your tax situation
      </a>
    </div>
  </div>
</section>
