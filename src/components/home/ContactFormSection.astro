---
import ContactForm from '@/components/ContactForm.astro';
---

<section id="contact" class="relative isolate bg-[#1A1A1A] py-20 lg:py-24 text-white overflow-hidden">
  <!-- Background Utah Red Rocks Photo -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <img
      src="https://ik.imagekit.io/twalkerco/michelle-turpin-pc/54b4c33beb94f018adaafb7fb7c39af1-1536.webp"
      alt="Utah landscape"
      class="w-full h-full object-cover object-center"
      loading="lazy"
      width="1792"
      height="1000" />
    <div class="absolute inset-0 bg-[#1A1A1A]/85"></div>
  </div>

  <div class="max-w-[1200px] mx-auto px-4 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
    <!-- Left Column -->
    <div class="lg:col-span-6">
      <h2 class="text-[28px] sm:text-[34px] lg:text-[38px] font-bold font-serif leading-[1.2] mb-4 text-white">
        We Do Utah State and Federal Tax Preparation
      </h2>
      <p class="text-gray-200 text-[15px] sm:text-[16px] leading-[1.7] mb-8">
        Our attorneys are highly experienced and knowledgeable of all areas of tax law. They have dealt with nearly every kind of tax situation imaginable, and they will be able to help you navigate the complex world of tax law.
      </p>

      <!-- Testimonial Box -->
      <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-[8px] p-6 text-white shadow-lg">
        <div class="text-[#f59e0b] text-[16px] tracking-wider mb-2 select-none" aria-label="5 stars">★★★★★</div>
        <p class="italic text-[15px] sm:text-[16px] text-gray-100 leading-relaxed mb-3 m-0">
          "Outstanding tax attorneys! Talk about tax savings! Thanks for all your help."
        </p>
        <p class="text-sm font-medium text-gray-300 m-0">
          — Joshua Echols
        </p>
      </div>
    </div>

    <!-- Right Column: Red Contact Card -->
    <div class="lg:col-span-6">
      <div class="bg-[#C1272D] rounded-[8px] p-6 lg:p-8 text-white shadow-2xl">
        <h3 class="text-[24px] font-bold font-serif mb-6 text-white text-left">
          Send Us Your Message
        </h3>

        <ContactForm idPrefix="home-contact" />
      </div>
    </div>
  </div>
</section>
