<section id="representation" class="relative isolate bg-white py-16 lg:py-20">
  <div class="max-w-[1200px] mx-auto px-4 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
    <!-- Left Column: Content -->
    <div class="lg:col-span-7">
      <h2 class="text-[26px] sm:text-[30px] font-bold text-[#1A1A1A] font-serif mb-6 leading-[1.2]">
        Get Tax, Criminal Tax, and Bankruptcy Representation You Can Count On — <span class="text-[#C1272D]">Federal and State Tax Attorney</span>
      </h2>
      <div class="text-[#374151] text-[15px] sm:text-[16px] leading-[1.7] space-y-4">
        <p>
          <strong class="text-[#C1272D] font-bold">Did you know that some taxes can be discharged in bankruptcy?</strong> Many people, including attorneys, mistakenly think that bankruptcy does not apply to taxes. While our bankruptcy practice is not exclusive to taxes, as a tax and bankruptcy law firm we have special expertise to apply in bankruptcy cases in which taxes are an issue.
        </p>

        <!-- Highlights with SVG Icons -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="flex items-start gap-3 p-3.5 rounded-lg bg-[#F9F6F0] border border-gray-200">
            <div class="w-8 h-8 rounded-full bg-[#C1272D] text-white flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
              <h4 class="text-[14px] font-bold text-[#1A1A1A] font-serif mb-0.5">Tax Debt Discharge</h4>
              <p class="text-[12px] text-gray-600 m-0">Eligible state and federal taxes can be eliminated.</p>
            </div>
          </div>

          <div class="flex items-start gap-3 p-3.5 rounded-lg bg-[#F9F6F0] border border-gray-200">
            <div class="w-8 h-8 rounded-full bg-[#C1272D] text-white flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <div>
              <h4 class="text-[14px] font-bold text-[#1A1A1A] font-serif mb-0.5">Dual Legal Expertise</h4>
              <p class="text-[12px] text-gray-600 m-0">Integrated tax litigation and bankruptcy solutions.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Image of Law Gavel & Scales -->
    <div class="lg:col-span-5">
      <div class="relative rounded-[8px] overflow-hidden shadow-xl bg-gray-100">
        <img
          src="https://ik.imagekit.io/twalkerco/michelle-turpin-pc/24afa832d07efdcd547677bd239d93e3-1024.webp"
          alt="Tax and Bankruptcy Law"
          class="w-full h-[420px] object-cover object-center"
          loading="lazy"
          width="1024"
          height="900" />
      </div>
    </div>
  </div>
</section>
